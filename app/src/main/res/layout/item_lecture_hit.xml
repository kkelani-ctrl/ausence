<?xml version="1.0" encoding="utf-8"?>
<!-- Lectures fork: a search hit inside a lecture, laid out like a song row (cover, title, info). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_item_bg"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_mid_medium"
    android:paddingEnd="@dimen/spacing_medium"
    android:paddingBottom="@dimen/spacing_mid_medium">

    <org.oxycblt.auxio.image.CoverView
        android:id="@+id/hit_cover"
        style="@style/Widget.Auxio.Image.Small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/hit_text"
        style="@style/Widget.Auxio.TextView.Item.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:singleLine="false"
        app:layout_constraintBottom_toTopOf="@+id/hit_song"
        app:layout_constraintEnd_toStartOf="@+id/hit_time"
        app:layout_constraintStart_toEndOf="@+id/hit_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="The meaning of the pyramid" />

    <TextView
        android:id="@+id/hit_song"
        style="@style/Widget.Auxio.TextView.Item.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/hit_time"
        app:layout_constraintStart_toEndOf="@+id/hit_cover"
        app:layout_constraintTop_toBottomOf="@+id/hit_text"
        tools:text="Chapter · The Secret Teachings · 12 min" />

    <TextView
        android:id="@+id/hit_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:fontFeatureSettings="tnum"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/hit_add"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="42:10" />

    <ImageButton
        android:id="@+id/hit_add"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lbl_add_to_playlist_chapter"
        android:src="@drawable/ic_playlist_add_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?android:attr/textColorSecondary" />

</androidx.constraintlayout.widget.ConstraintLayout>
