<?xml version="1.0" encoding="utf-8"?>
<!-- Cinematic transcript line: large text, the current line bright and the rest faded. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_large"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/line_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:text="12:04" />

    <TextView
        android:id="@+id/line_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadlineSmallEmphasized"
        android:textColor="?attr/colorOnSurface"
        tools:text="There is a truth component to it." />
</LinearLayout>
